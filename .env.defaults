# Defaults so that `docker compose up` works without configuring anything (local development).
# Don't put secrets here: to change something (or on a server) create a `.env` with only what changes;
# whatever is in `.env` overrides this. Template with every option: .env.example.

# --- Django ---
DJANGO_SECRET_KEY=dev-insecure-solo-para-local
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Trusted origins for requests that change something (the local web, also with an admin session open)
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Administrator created automatically if there is none (change it on a server)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com

# --- PostgreSQL and Redis (the compose containers) ---
POSTGRES_DB=dbs
POSTGRES_USER=dbs
POSTGRES_PASSWORD=dbs
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379

# --- Bandai TCG+ ---
BANDAI_GAME_TITLE_ID=1
BANDAI_REQUEST_DELAY=0.25
BANDAI_WORKERS=4

# --- Initial data: with an empty database, the catalog and prices from data/seed/ are imported ---
IMPORT_ON_START=/data/cartas_dbs.json

# --- Scanner ---
MATCH_MIN_CONFIDENCE=0.45
AUTO_ADD_MIN_CONFIDENCE=0.65
SCAN_RETENTION_HOURS=24
SCAN_PHOTOS_MAX_MB=2048
SCAN_PHOTOS_TARGET_MB=1536
