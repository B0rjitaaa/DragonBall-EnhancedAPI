# Valores por defecto para que `docker compose up` funcione sin configurar nada (desarrollo en local).
# No pongas aquí secretos: para cambiar algo (o en un servidor) crea un `.env` con solo lo que cambie;
# lo del `.env` manda sobre esto. Plantilla con todas las opciones: .env.example.

# --- Django ---
DJANGO_SECRET_KEY=dev-insecure-solo-para-local
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Administrador que se crea solo si no hay ninguno (cámbialo en un servidor)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com

# --- PostgreSQL y Redis (los contenedores del compose) ---
POSTGRES_DB=dbs
POSTGRES_USER=dbs
POSTGRES_PASSWORD=dbs
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379

# --- Bandai TCG+ ---
BANDAI_GAME_TITLE_ID=1
BANDAI_REQUEST_DELAY=0.25
BANDAI_WORKERS=4

# --- Datos iniciales: con la base vacía se importan el catálogo y los precios de data/seed/ ---
IMPORT_ON_START=/data/cartas_dbs.json

# --- Escáner ---
MATCH_MIN_CONFIDENCE=0.45
AUTO_ADD_MIN_CONFIDENCE=0.65
SCAN_RETENTION_HOURS=24
SCAN_PHOTOS_MAX_MB=2048
SCAN_PHOTOS_TARGET_MB=1536
