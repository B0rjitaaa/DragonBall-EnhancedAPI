# --- Django ---
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- PostgreSQL ---
POSTGRES_DB=dbs
POSTGRES_USER=dbs
POSTGRES_PASSWORD=dbs
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379

# --- Bandai TCG+ ---
BANDAI_GAME_TITLE_ID=1
# Segundos entre peticiones y peticiones simultáneas (si Bandai bloquea, sube el delay)
BANDAI_REQUEST_DELAY=0.25
BANDAI_WORKERS=4

# Importar este JSON al arrancar si la base de datos está vacía
IMPORT_ON_START=/data/cartas_dbs.json

# Orígenes del admin por HTTPS (separados por comas), p. ej. https://192.168.178.104:8443
# DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Escáner ---
# Identificación (ver backend/config/settings.py).
MATCH_MIN_CONFIDENCE=0.55
AUTO_ADD_MIN_CONFIDENCE=0.65
SCAN_RETENTION_DAYS=30
# Puertos de la web en producción. HTTPS solo si hay certificados en ./certs
# (scripts/local-https.sh <ip>); la cámara del móvil solo funciona por HTTPS.
HTTP_PORT=5173
HTTPS_PORT=8443

# --- Webcam del archivador (solo donde la haya) ---
# COMPOSE_PROFILES=camera
# CAMERA_URL=http://camera:8080
# CAMERA_DEVICE=/dev/video0
# CAMERA_WIDTH=1920
# CAMERA_HEIGHT=1080
# CAMERA_FPS=15
# CAMERA_FOURCC=MJPG
# CAMERA_PREVIEW_WIDTH=960
# Controles v4l2 al arrancar, en orden (`v4l2-ctl -d /dev/video0 --list-ctrls`).
# CAMERA_CONTROLS=
