# --- Django ---
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- PostgreSQL ---
POSTGRES_DB=dbs
POSTGRES_USER=dbs
POSTGRES_PASSWORD=dbs
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379

# --- Bandai TCG+ ---
BANDAI_GAME_TITLE_ID=1
# Segundos entre peticiones y peticiones simultáneas (si Bandai bloquea, sube el delay)
BANDAI_REQUEST_DELAY=0.25
BANDAI_WORKERS=4

# Base vacía al arrancar: se importan el catálogo y los precios. Si existe este JSON se usa; si no, el
# volcado que va en el repositorio (data/seed/). Los precios: data/precios_dbs.json (lo rehace el servidor
# cada día) o, si no está, data/seed/precios_dbs.json.gz.
IMPORT_ON_START=/data/cartas_dbs.json

# Administrador que se crea solo si no hay ninguno (por defecto admin / admin; en un servidor, otra)
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_PASSWORD=

# Orígenes del admin por HTTPS (separados por comas), p. ej. https://192.168.1.50
# DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Escáner ---
# Identificación (ver backend/config/settings.py).
MATCH_MIN_CONFIDENCE=0.45
AUTO_ADD_MIN_CONFIDENCE=0.65
SCAN_RETENTION_HOURS=24
SCAN_PHOTOS_MAX_MB=2048
SCAN_PHOTOS_TARGET_MB=1536
# Puertos de la web en producción. HTTPS solo si hay certificados en ./certs
# (scripts/local-https.sh <ip>); la cámara del móvil solo funciona por HTTPS.
# La web también responde siempre en :5173 (enlaces antiguos).
HTTP_PORT=80
HTTPS_PORT=443

# --- Avisos por Telegram (cards/alerts.py y scripts/watchdog.py) ---
# Bot creado con @BotFather y chat al que escribe (vacíos: sin avisos).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Vigilancia de caídas desde fuera (opcional): URL de ping de Healthchecks.io o compatible ---
# HEALTHCHECKS_URL=

# --- Webcam del archivador (solo donde la haya) ---
# COMPOSE_PROFILES=camera
# CAMERA_URL=http://camera:8080
# CAMERA_DEVICE=/dev/video0
# CAMERA_WIDTH=1920
# CAMERA_HEIGHT=1080
# CAMERA_FPS=15
# CAMERA_FOURCC=MJPG
# CAMERA_PREVIEW_WIDTH=960
# Controles v4l2 al arrancar, en orden (`v4l2-ctl -d /dev/video0 --list-ctrls`).
# CAMERA_CONTROLS=
