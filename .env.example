# --- Django ---
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- PostgreSQL ---
POSTGRES_DB=dbs
POSTGRES_USER=dbs
POSTGRES_PASSWORD=dbs
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379

# --- Bandai TCG+ ---
BANDAI_GAME_TITLE_ID=1
# Segundos entre peticiones y peticiones simultáneas (si Bandai bloquea, sube el delay)
BANDAI_REQUEST_DELAY=0.25
BANDAI_WORKERS=4

# Importar este JSON al arrancar si la base de datos está vacía
IMPORT_ON_START=/data/cartas_dbs.json
