# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-key
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- PostgreSQL ---
POSTGRES_DB=dbs
POSTGRES_USER=dbs
POSTGRES_PASSWORD=dbs
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379

# --- Bandai TCG+ ---
BANDAI_GAME_TITLE_ID=1
# Seconds between requests and concurrent requests (if Bandai blocks you, raise the delay)
BANDAI_REQUEST_DELAY=0.25
BANDAI_WORKERS=4

# Empty database at startup: the catalog and prices are imported. If this JSON exists it is used; if not,
# the dump shipped in the repository (data/seed/). Prices: data/precios_dbs.json (the server rebuilds it
# every day) or, if it is missing, data/seed/precios_dbs.json.gz.
IMPORT_ON_START=/data/cartas_dbs.json

# Administrator created automatically if there is none (admin / admin by default; use another on a server)
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_PASSWORD=

# Admin origins over HTTPS (comma-separated), e.g. https://192.168.1.50
# DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Scanner ---
# Identification (see backend/config/settings.py).
MATCH_MIN_CONFIDENCE=0.45
AUTO_ADD_MIN_CONFIDENCE=0.65
SCAN_RETENTION_HOURS=24
SCAN_PHOTOS_MAX_MB=2048
SCAN_PHOTOS_TARGET_MB=1536
# Web ports in production. HTTPS only if there are certificates in ./certs
# (scripts/local-https.sh <ip>); the phone camera only works over HTTPS.
# The web also always answers on :5173 (old links).
HTTP_PORT=80
HTTPS_PORT=443

# --- Telegram alerts (cards/alerts.py and scripts/watchdog.py) ---
# Bot created with @BotFather and the chat it writes to (empty: no alerts).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Outside downtime monitoring (optional): Healthchecks.io (or compatible) ping URL ---
# HEALTHCHECKS_URL=

# --- Binder webcam (only where there is one) ---
# COMPOSE_PROFILES=camera
# CAMERA_URL=http://camera:8080
# CAMERA_DEVICE=/dev/video0
# CAMERA_WIDTH=1920
# CAMERA_HEIGHT=1080
# CAMERA_FPS=15
# CAMERA_FOURCC=MJPG
# CAMERA_PREVIEW_WIDTH=960
# v4l2 controls applied at startup, in order (`v4l2-ctl -d /dev/video0 --list-ctrls`).
# CAMERA_CONTROLS=
